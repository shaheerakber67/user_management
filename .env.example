APP_HOST=127.0.0.1
APP_PORT=8080
RUST_LOG=info

# Postgres connection used by the app, sqlx-cli and `#[sqlx::test]`.
DATABASE_URL=postgres://postgres:password@localhost:5432/food_ordering
DATABASE_MAX_CONNECTIONS=10

# Signs login tokens. At least 32 bytes; generate one per environment, e.g.
# `openssl rand -base64 48`. Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more
# How long a login token stays valid.
JWT_TTL_MINUTES=60
